# Copie este arquivo para .env e preencha com os valores reais.
# .env nunca deve ser commitado (já está no .gitignore).
# Em produção (Dokploy), essas mesmas variáveis são definidas direto no
# painel — não é preciso subir nenhum arquivo .env pro servidor.

MAKE_WEBHOOK_URL=

# --- Login ---
SECRET_KEY=
SESSION_COOKIE_SECURE=false

# Cria/sincroniza esse usuário como admin a cada boot (remova depois que
# o login estiver funcionando e a equipe já tiver acesso).
ADMIN_INICIAL_NOME=
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_SENHA=

# Mesma ideia, pra vários membros de uma vez — lista JSON de objetos
# {nome, email, senha, papel}. papel é "admin" ou "equipe".
# Exemplo: EQUIPE_INICIAL=[{"nome":"Fulano","email":"fulano@x.com","senha":"abc123","papel":"equipe"}]
EQUIPE_INICIAL=

TOKEN_ARTESANOS=
GRUPO_WHATSAPP_ARTESANOS=

TOKEN_ACAI=
GRUPO_WHATSAPP_ACAI=

TOKEN_ZN=
GRUPO_WHATSAPP_ZN=

TOKEN_SIMUS=
GRUPO_WHATSAPP_SIMUS=

# --- Dados fiscais das lojas ---
# Alimentam o bloco por loja da mensagem de "Gerar pedidos". Uma linha só,
# JSON, com a chave sendo o nome da loja exatamente como está em LOJAS
# (config.py). Campo que faltar sai como "Não informado" na mensagem.
# Exemplo (valores inventados):
# DADOS_FISCAIS_LOJAS={"Hamburgueria Artesanos":{"nomeFantasia":"Fulano Burger","razaoSocial":"Fulano Burger LTDA","cnpj":"00.000.000/0001-00"},"Açaí Na Lata":{"nomeFantasia":"","razaoSocial":"","cnpj":""}}
DADOS_FISCAIS_LOJAS=
